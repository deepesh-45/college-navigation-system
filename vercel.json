{
  "services": {
    "college-navigation-system": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "college-navigation-system"
      }
    }
  ]
}
